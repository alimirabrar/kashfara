# KASHFARA VISION — Environment Configuration
# Keep all API credentials server-side. Never expose secrets to the browser.

# A. Groq Direct API (https://api.groq.com/openai/v1)
GROQ_API_KEY=

# B. OmniRoute Multi-Provider Gateway (e.g. http://localhost:20128 or hosted URL)
OMNIROUTE_BASE_URL=
OMNIROUTE_API_KEY=

# Routing Preferences
AI_PRIMARY_PROVIDER=auto
AI_SECONDARY_PROVIDER=auto

# Strict Free-Only Mode (never silently fall back to paid inference)
FREE_ONLY_MODE=true

# Capacity & Workload Limits
DAILY_DOCUMENT_TARGET=30
MAX_UPLOAD_SIZE_MB=20
MAX_DOCUMENT_PAGES=10
DEFAULT_WORKLOAD_PAGES=5

# Optional Explicit Model Overrides (leave blank for automatic capability-based routing)
GROQ_VISION_MODEL=
OMNIROUTE_PREFERRED_VISION_MODEL=

# Vercel Blob (Private storage for larger uploads in production)
BLOB_READ_WRITE_TOKEN=
